{
  "permissions": {
    "allow": [
      "Bash(gog --account yuki.katayama@fout.jp --gmail-no-send -j calendar create primary --summary \"[作業] 今日の5件\" *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*slack_send_message",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/allow_slack_routine_post.py\""
          }
        ]
      }
    ]
  }
}
